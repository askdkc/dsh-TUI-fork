{
  "name": "@askdkc/dsh-auth",
  "version": "0.1.1",
  "description": "Provider authentication and model routes for DeepSeek Harness — no dsh source patch, bundled with dsh-cli",
  "license": "MIT",
  "author": {
    "name": "dkc",
    "url": "https://github.com/askdkc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askdkc/dsh-cli.git",
    "directory": "dsh-auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "smoke": "node scripts/smoke.mjs",
    "sync:models": "node scripts/sync-opencode-models.mjs",
    "verify": "npm run build && npm run smoke"
  },
